rules_version = '2';

// =====================================================================
// LOREVIA ENTERTAINMENT RVN 🌿 - ATURAN DATABASE (FIRESTORE)
// Situs tidak memakai login, jadi baca/tulis terbuka, tetapi:
//  - hanya koleksi yang terdaftar di bawah yang bisa dipakai,
//  - setiap fitur punya fungsi pemeriksa sendiri (tipe & panjang data),
//  - pemeriksaan hanya berlaku bila kolomnya ada (data lama tetap aman).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // ALAT BANTU UMUM
    // ---------------------------------------------------------------
    function body()  { return request.resource.data; }
    function has(f)  { return f in body(); }
    function small() { return body().keys().size() <= 80; }

    function str(f, max) {
      return !has(f) || (body()[f] is string && body()[f].size() <= max);
    }
    function num(f) {
      return !has(f) || body()[f] is number;
    }
    function flag(f) {
      return !has(f) || body()[f] is bool;
    }
    function arr(f, max) {
      return !has(f) || (body()[f] is list && body()[f].size() <= max);
    }
    // gambar disimpan sebagai teks base64 (maks ~950 KB per dokumen)
    function pic(f) {
      return !has(f) || !(body()[f] is string) || body()[f].size() <= 950000;
    }
    function orderOk() { return num('_order'); }
    function base()    { return small() && orderOk(); }

    // ---------------------------------------------------------------
    // PEMERIKSA PER FITUR
    // ---------------------------------------------------------------
    function okAnnouncement() {
      return base() && str('title', 300) && str('content', 200000) && str('date', 60) && pic('img') && pic('image');
    }
    function okAchievement() {
      return base() && str('title', 300) && str('desc', 200000) && str('year', 30) && pic('img');
    }
    function okHistory() {
      return base() && str('title', 300) && str('date', 60) && str('story', 200000) && arr('contents', 40) && pic('img');
    }
    function okCooperation() {
      return base() && str('title', 300) && str('partner', 300) && str('date', 60) && str('story', 200000) && arr('contents', 40) && pic('img');
    }
    function okDispatch() {
      return base() && str('title', 300) && str('date', 60) && str('content', 200000) && pic('img');
    }
    function okMedpart() {
      return base() && str('title', 300) && str('partner', 300) && str('date', 60) && str('desc', 200000) && pic('img');
    }
    function okStructure() {
      return base() && str('name', 200) && str('role', 200) && pic('img');
    }
    function okGeneration() {
      return base() && has('name') && str('name', 100) && body().name.size() > 0;
    }
    function okMember() {
      return base() && str('name', 200) && str('stageName', 200) && str('dob', 30) && str('faceClaim', 200)
          && str('tiktok', 300) && str('genId', 80) && pic('img');
    }
    function okGuest() {
      return base() && str('name', 100) && str('message', 1000);
    }
    function okProduct() {
      return base() && str('name', 300) && str('description', 5000) && num('price') && num('qty') && arr('images', 12);
    }
    function okPromo() {
      return base() && str('code', 60) && str('type', 20) && num('value') && num('maxDiscount') && num('minPurchase');
    }
    function okOrder() {
      return base() && str('status', 40) && num('total');
    }
    function okVideoPlaylist() {
      return base() && str('name', 200) && str('desc', 2000) && pic('cover');
    }
    function okVideo() {
      return base() && str('title', 300) && num('likes') && num('views') && num('commentCount') && pic('thumb');
    }
    function okAudioPlaylist() {
      return base() && str('name', 200) && str('desc', 2000) && pic('cover');
    }
    function okAudio() {
      return base() && str('title', 300) && str('artist', 200) && str('kind', 20)
          && num('likes') && num('plays') && num('commentCount') && pic('cover');
    }
    function okChunk() {
      return small() && body().d is string && body().d.size() <= 800000;
    }
    function okComment() {
      return small()
          && body().type in ['video', 'audio']
          && body().itemId is string && body().itemId.size() <= 80
          && body().name is string && body().name.size() > 0 && body().name.size() <= 60
          && body().text is string && body().text.size() > 0 && body().text.size() <= 500;
    }

    // ---------------------------------------------------------------
    // 1. PENGUMUMAN (foto opsional + isi "baca selengkapnya")
    // ---------------------------------------------------------------
    match /announcements/{id} {
      allow get, list: if true;
      allow create: if okAnnouncement();
      allow update: if okAnnouncement();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 2. ACHIEVEMENT / PENGHARGAAN
    // ---------------------------------------------------------------
    match /achievements/{id} {
      allow get, list: if true;
      allow create: if okAchievement();
      allow update: if okAchievement();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 3. HISTORY AGENSI (khusus sejarah Lorevia)
    // ---------------------------------------------------------------
    match /histories/{id} {
      allow get, list: if true;
      allow create: if okHistory();
      allow update: if okHistory();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 4. KERJA SAMA / COOPERATION (terpisah dari History)
    // ---------------------------------------------------------------
    match /cooperations/{id} {
      allow get, list: if true;
      allow create: if okCooperation();
      allow update: if okCooperation();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 5. DISPATCH / BERITA RESMI
    // ---------------------------------------------------------------
    match /dispatches/{id} {
      allow get, list: if true;
      allow create: if okDispatch();
      allow update: if okDispatch();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 6. OFFICIAL PROMOTE / MEDPART
    // ---------------------------------------------------------------
    match /medparts/{id} {
      allow get, list: if true;
      allow create: if okMedpart();
      allow update: if okMedpart();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 7. STRUKTUR TEAM (bagan organisasi)
    // ---------------------------------------------------------------
    match /adminStructure/{id} {
      allow get, list: if true;
      allow create: if okStructure();
      allow update: if okStructure();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 8. GENERASI (Gen 1, Gen 2, ... diatur dari dasbor)
    // ---------------------------------------------------------------
    match /generations/{id} {
      allow get, list: if true;
      allow create: if okGeneration();
      allow update: if okGeneration();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 9. MEMBERS / ARTIS (nama, tanggal lahir, face claim, TikTok, foto)
    // ---------------------------------------------------------------
    match /members/{id} {
      allow get, list: if true;
      allow create: if okMember();
      allow update: if okMember();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 10. GUEST BOX (pesan pengunjung)
    // ---------------------------------------------------------------
    match /guestBoxes/{id} {
      allow get, list: if true;
      allow create: if okGuest();
      allow update: if okGuest();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 11. TOKO: PRODUK
    // ---------------------------------------------------------------
    match /products/{id} {
      allow get, list: if true;
      allow create: if okProduct();
      allow update: if okProduct();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 12. TOKO: PROMO & VOUCHER
    // ---------------------------------------------------------------
    match /promos/{id} {
      allow get, list: if true;
      allow create: if okPromo();
      allow update: if okPromo();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 13. TOKO: PESANAN
    // ---------------------------------------------------------------
    match /orders/{id} {
      allow get, list: if true;
      allow create: if okOrder();
      allow update: if okOrder();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 14. AKTIVITAS - VIDEO: PLAYLIST
    // ---------------------------------------------------------------
    match /videoPlaylists/{id} {
      allow get, list: if true;
      allow create: if okVideoPlaylist();
      allow update: if okVideoPlaylist();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 15. AKTIVITAS - VIDEO: ITEM VIDEO (suka, tonton, komentar)
    // ---------------------------------------------------------------
    match /videos/{id} {
      allow get, list: if true;
      allow create: if okVideo();
      allow update: if okVideo();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 16. AKTIVITAS - AUDIO: PLAYLIST
    // ---------------------------------------------------------------
    match /audioPlaylists/{id} {
      allow get, list: if true;
      allow create: if okAudioPlaylist();
      allow update: if okAudioPlaylist();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 17. AKTIVITAS - AUDIO: ITEM LAGU (judul, artis, cover/ORI, suka)
    // ---------------------------------------------------------------
    match /audios/{id} {
      allow get, list: if true;
      allow create: if okAudio();
      allow update: if okAudio();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 18. FILE VIDEO & AUDIO (dipecah per potongan)
    // ---------------------------------------------------------------
    match /mediaChunks/{id} {
      allow get, list: if true;
      allow create: if okChunk();
      allow update: if okChunk();
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 19. KOMENTAR VIDEO & AUDIO (boleh dibuat & dihapus, tidak boleh diubah)
    // ---------------------------------------------------------------
    match /comments/{id} {
      allow get, list: if true;
      allow create: if okComment();
      allow update: if false;
      allow delete: if true;
    }

    // ---------------------------------------------------------------
    // 20. PENGATURAN UMUM (cadangan, tidak boleh dihapus)
    // ---------------------------------------------------------------
    match /settings/{id} {
      allow get, list: if true;
      allow create: if small();
      allow update: if small();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // SELAIN YANG DI ATAS: DITOLAK
    // ---------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
