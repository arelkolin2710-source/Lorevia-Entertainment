rules_version = '2';

// =====================================================================
// LOREVIA ENTERTAINMENT RVN 🌿 - ATURAN DATABASE (FIRESTORE)
// Konten situs & dasbor admin tanpa login (baca/tulis terbuka, tetapi dibatasi bentuk datanya).
// Lorevia Verse memakai Firebase Authentication (Google) untuk surat, profil, dan vote.
// Pembatasan:
//  - hanya koleksi yang terdaftar di bawah yang bisa dipakai,
//  - setiap fitur punya fungsi pemeriksa sendiri (tipe & panjang data),
//  - pemeriksaan hanya berlaku bila kolomnya ada (data lama tetap aman).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // DAFTAR ISI  (tiap fitur = SATU BLOK mandiri: fungsi pemeriksa + aturan koleksi)
    //   Mengubah/menghapus satu blok tidak memengaruhi blok lain.
    //   BAGIAN BERSAMA : alat bantu umum + pemeriksa peran artis/grup Verse
    //   F01 PENGUMUMAN
    //   F02 ACHIEVEMENT AGENSI
    //   F03 HISTORY AGENSI
    //   F04 KERJA SAMA
    //   F05 DISPATCH / BERITA RESMI
    //   F06 OFFICIAL PROMOTE / MEDPART
    //   F07 STRUKTUR TEAM
    //   F08 GENERASI
    //   F09 MEMBERS / ARTIS SITUS
    //   F10 GUEST BOX
    //   F11 TOKO: PRODUK (termasuk store grup Verse)
    //   F12 TOKO: PROMO & VOUCHER
    //   F13 TOKO: PESANAN
    //   F14 VIDEO: PLAYLIST
    //   F15 VIDEO: ITEM
    //   F16 AUDIO: PLAYLIST
    //   F17 AUDIO: ITEM LAGU
    //   F18 FILE VIDEO & AUDIO (potongan)
    //   F19 KOMENTAR (video, audio, postingan Verse)
    //   V01 VERSE: AKUN GRUP
    //   V02 VERSE: AKUN ARTIS (termasuk achievement tambahan)
    //   V03 VERSE: POSTINGAN ARTIS/GRUP (musik, eksklusif)
    //   V04 VERSE: STORY ARTIS
    //   V05 VERSE: PEMBAYARAN KONTEN EKSKLUSIF
    //   V06 VERSE: PERAN ARTIS/GRUP (email -> akun)
    //   V07 VERSE: PROFIL PENGGUNA
    //   V08 VERSE: POSTINGAN PENGGEMAR
    //   V09 VERSE: USERNAME UNIK
    //   V10 VERSE: LANGGANAN CHAT & CALL (ditulis server saat bayar terdeteksi)
    //   V11 VERSE: PESAN CHAT
    //   V12 VERSE: PANGGILAN SUARA (sinyal WebRTC)
    //   V13 VERSE: SURAT UNTUK IDOL
    //   V14 VERSE: EVENT VOTE
    //   V15 VERSE: SUARA VOTE
    //   V16 VERSE: BANNER IKLAN BERANDA
    //   V17 VERSE: TAGIHAN PEMBAYARAN (ditulis server)
    //   S01 PENGATURAN UMUM
    //   PENUTUP        : semua koleksi lain ditolak
    // =====================================================================

    // ---------------------------------------------------------------
    // BAGIAN BERSAMA 1: ALAT BANTU UMUM (dipakai banyak blok; jangan diubah sembarangan)
    // ---------------------------------------------------------------
    function body()  { return request.resource.data; }
    function has(f)  { return f in body(); }
    function small() { return body().keys().size() <= 80; }
    function str(f, max) {
      return !has(f) || (body()[f] is string && body()[f].size() <= max);
    }
    function num(f) {
      return !has(f) || body()[f] is number;
    }
    function flag(f) {
      return !has(f) || body()[f] is bool;
    }
    function arr(f, max) {
      return !has(f) || (body()[f] is list && body()[f].size() <= max);
    }
    // gambar disimpan sebagai teks base64 (maks ~950 KB per dokumen)
    function pic(f) {
      return !has(f) || !(body()[f] is string) || body()[f].size() <= 950000;
    }
    function orderOk() { return num('_order'); }
    function base()    { return small() && orderOk(); }

    // ---------------------------------------------------------------
    // BAGIAN BERSAMA 2: PEMERIKSA PERAN VERSE (dipakai surat, chat, call)
    // peran sah = dokumen verseStaff milik email Google/akun artis + versi cocok dengan akun
    // ---------------------------------------------------------------
    // peran artis/grup yang sah: dokumen verseStaff milik email Google ini + versinya cocok dengan data akun
    function staffDoc() {
      return get(/databases/$(database)/documents/verseStaff/$(request.auth.token.email.lower())).data;
    }
    function isStaffFor(toId) {
      return request.auth != null
          && (request.auth.token.email_verified == true || request.auth.token.email.lower().matches('.*@artist[.]lorevia[.]app'))
          && exists(/databases/$(database)/documents/verseStaff/$(request.auth.token.email.lower()))
          && staffDoc().refId == toId
          && (staffDoc().kind == 'artist'
              ? get(/databases/$(database)/documents/verseArtists/$(toId)).data.get('staffVer', '') == staffDoc().ver
              : get(/databases/$(database)/documents/verseGroups/$(toId)).data.get('staffVer', '') == staffDoc().ver);
    }

    // =====================================================================
    // F01 PENGUMUMAN
    // =====================================================================
    function okAnnouncement() {
      return base() && str('title', 300) && str('content', 200000) && str('date', 60) && pic('img') && pic('image');
    }
    match /announcements/{id} {
      allow get, list: if true;
      allow create: if okAnnouncement();
      allow update: if okAnnouncement();
      allow delete: if true;
    }

    // =====================================================================
    // F02 ACHIEVEMENT AGENSI
    // =====================================================================
    function okAchievement() {
      return base() && str('title', 300) && str('desc', 200000) && str('year', 30) && pic('img');
    }
    match /achievements/{id} {
      allow get, list: if true;
      allow create: if okAchievement();
      allow update: if okAchievement();
      allow delete: if true;
    }

    // =====================================================================
    // F03 HISTORY AGENSI
    // =====================================================================
    function okHistory() {
      return base() && str('title', 300) && str('date', 60) && str('story', 200000) && arr('contents', 40) && pic('img');
    }
    match /histories/{id} {
      allow get, list: if true;
      allow create: if okHistory();
      allow update: if okHistory();
      allow delete: if true;
    }

    // =====================================================================
    // F04 KERJA SAMA
    // =====================================================================
    function okCooperation() {
      return base() && str('title', 300) && str('partner', 300) && str('date', 60) && str('story', 200000) && arr('contents', 40) && pic('img');
    }
    match /cooperations/{id} {
      allow get, list: if true;
      allow create: if okCooperation();
      allow update: if okCooperation();
      allow delete: if true;
    }

    // =====================================================================
    // F05 DISPATCH / BERITA RESMI
    // =====================================================================
    function okDispatch() {
      return base() && str('title', 300) && str('date', 60) && str('content', 200000) && pic('img');
    }
    match /dispatches/{id} {
      allow get, list: if true;
      allow create: if okDispatch();
      allow update: if okDispatch();
      allow delete: if true;
    }

    // =====================================================================
    // F06 OFFICIAL PROMOTE / MEDPART
    // =====================================================================
    function okMedpart() {
      return base() && str('title', 300) && str('partner', 300) && str('date', 60) && str('desc', 200000) && pic('img');
    }
    match /medparts/{id} {
      allow get, list: if true;
      allow create: if okMedpart();
      allow update: if okMedpart();
      allow delete: if true;
    }

    // =====================================================================
    // F07 STRUKTUR TEAM
    // =====================================================================
    function okStructure() {
      return base() && str('name', 200) && str('role', 200) && pic('img');
    }
    match /adminStructure/{id} {
      allow get, list: if true;
      allow create: if okStructure();
      allow update: if okStructure();
      allow delete: if true;
    }

    // =====================================================================
    // F08 GENERASI
    // =====================================================================
    function okGeneration() {
      return base() && has('name') && str('name', 100) && body().name.size() > 0;
    }
    match /generations/{id} {
      allow get, list: if true;
      allow create: if okGeneration();
      allow update: if okGeneration();
      allow delete: if true;
    }

    // =====================================================================
    // F09 MEMBERS / ARTIS SITUS
    // =====================================================================
    function okMember() {
      return base() && str('name', 200) && str('stageName', 200) && str('dob', 30) && str('faceClaim', 200)
          && str('tiktok', 300) && str('genId', 80) && pic('img');
    }
    match /members/{id} {
      allow get, list: if true;
      allow create: if okMember();
      allow update: if okMember();
      allow delete: if true;
    }

    // =====================================================================
    // F10 GUEST BOX
    // =====================================================================
    function okGuest() {
      return base() && str('name', 100) && str('message', 1000);
    }
    match /guestBoxes/{id} {
      allow get, list: if true;
      allow create: if okGuest();
      allow update: if okGuest();
      allow delete: if true;
    }

    // =====================================================================
    // F11 TOKO: PRODUK (termasuk store grup Verse)
    // =====================================================================
    function okProduct() {
      return base() && str('name', 300) && str('description', 5000) && num('price') && num('qty') && arr('images', 12)
          && str('artistId', 80) && str('groupId', 80) && (!has('kind') || body().kind in ['album', 'merch']);
    }
    match /products/{id} {
      allow get, list: if true;
      allow create: if okProduct();
      allow update: if okProduct();
      allow delete: if true;
    }

    // =====================================================================
    // F12 TOKO: PROMO & VOUCHER
    // =====================================================================
    function okPromo() {
      return base() && str('code', 60) && str('type', 20) && num('value') && num('maxDiscount') && num('minPurchase');
    }
    match /promos/{id} {
      allow get, list: if true;
      allow create: if okPromo();
      allow update: if okPromo();
      allow delete: if true;
    }

    // =====================================================================
    // F13 TOKO: PESANAN
    // =====================================================================
    function okOrder() {
      return base() && str('status', 40) && num('total');
    }
    match /orders/{id} {
      allow get, list: if true;
      allow create: if okOrder();
      allow update: if okOrder();
      allow delete: if true;
    }

    // =====================================================================
    // F14 VIDEO: PLAYLIST
    // =====================================================================
    function okVideoPlaylist() {
      return base() && str('name', 200) && str('desc', 2000) && pic('cover');
    }
    match /videoPlaylists/{id} {
      allow get, list: if true;
      allow create: if okVideoPlaylist();
      allow update: if okVideoPlaylist();
      allow delete: if true;
    }

    // =====================================================================
    // F15 VIDEO: ITEM
    // =====================================================================
    function okVideo() {
      return base() && str('title', 300) && num('likes') && num('views') && num('commentCount') && pic('thumb');
    }
    match /videos/{id} {
      allow get, list: if true;
      allow create: if okVideo();
      allow update: if okVideo();
      allow delete: if true;
    }

    // =====================================================================
    // F16 AUDIO: PLAYLIST
    // =====================================================================
    function okAudioPlaylist() {
      return base() && str('name', 200) && str('desc', 2000) && pic('cover');
    }
    match /audioPlaylists/{id} {
      allow get, list: if true;
      allow create: if okAudioPlaylist();
      allow update: if okAudioPlaylist();
      allow delete: if true;
    }

    // =====================================================================
    // F17 AUDIO: ITEM LAGU
    // =====================================================================
    function okAudio() {
      return base() && str('title', 300) && str('artist', 200) && str('kind', 20)
          && num('likes') && num('plays') && num('commentCount') && pic('cover');
    }
    match /audios/{id} {
      allow get, list: if true;
      allow create: if okAudio();
      allow update: if okAudio();
      allow delete: if true;
    }

    // =====================================================================
    // F18 FILE VIDEO & AUDIO (potongan)
    // =====================================================================
    function okChunk() {
      return small() && body().d is string && body().d.size() <= 800000;
    }
    match /mediaChunks/{id} {
      allow get, list: if true;
      allow create: if okChunk();
      allow update: if okChunk();
      allow delete: if true;
    }

    // =====================================================================
    // F19 KOMENTAR (video, audio, postingan Verse)
    // =====================================================================
    function okComment() {
      return small()
          && body().type in ['video', 'audio', 'versePost']
          && body().itemId is string && body().itemId.size() <= 80
          && body().name is string && body().name.size() > 0 && body().name.size() <= 60
          && body().text is string && body().text.size() > 0 && body().text.size() <= 500
          && str('uid', 128) && str('av', 14000) && str('by', 80);
    }
    match /comments/{id} {
      allow get, list: if true;
      allow create: if okComment();
      allow update: if false;
      allow delete: if true;
    }

    // =====================================================================
    // V01 VERSE: AKUN GRUP
    // =====================================================================
    function okVerseGroup() {
      return base() && has('name') && str('name', 100) && body().name.size() > 0 && str('bio', 500) && str('slug', 60) && str('staffVer', 40) && str('emailHint', 80) && pic('photo') && pic('banner');
    }
    match /verseGroups/{id} {
      allow get, list: if true;
      allow create: if okVerseGroup();
      allow update: if okVerseGroup();
      allow delete: if true;
    }

    // =====================================================================
    // V02 VERSE: AKUN ARTIS (termasuk achievement tambahan)
    // =====================================================================
    function okVerseArtist() {
      return base() && has('name') && str('name', 100) && body().name.size() > 0 && str('groupId', 80) && str('bio', 500)
          && str('staffVer', 40) && str('emailHint', 80) && pic('photo') && arr('achv', 20);
    }
    match /verseArtists/{id} {
      allow get, list: if true;
      allow create: if okVerseArtist();
      allow update: if okVerseArtist();
      allow delete: if true;
    }

    // =====================================================================
    // V03 VERSE: POSTINGAN ARTIS/GRUP (musik, eksklusif)
    // =====================================================================
    function okVersePost() {
      return base() && str('text', 3000) && arr('photos', 10) && str('groupId', 80) && str('authorId', 80)
          && (!has('authorType') || body().authorType in ['group', 'artist'])
          && flag('exclusive') && (!has('spotify') || body().spotify == null || body().spotify is map)
          && (!has('price') || (body().price is number && body().price >= 0 && body().price <= 10000))
          && num('likes') && num('ts');
    }
    match /versePosts/{id} {
      allow get, list: if true;
      allow create: if okVersePost();
      allow update: if okVersePost();
      allow delete: if true;
    }

    // =====================================================================
    // V04 VERSE: STORY ARTIS
    // =====================================================================
    function okVerseStory() {
      return base() && str('artistId', 80) && str('groupId', 80) && str('text', 300) && pic('photo') && num('ts');
    }
    match /verseStories/{id} {
      allow get, list: if true;
      allow create: if okVerseStory();
      allow update: if okVerseStory();
      allow delete: if true;
    }

    // =====================================================================
    // V05 VERSE: PEMBAYARAN KONTEN EKSKLUSIF
    // =====================================================================
    function okVerseUnlock() {
      return base() && str('postId', 80) && str('buyer', 100) && str('contact', 200) && str('code', 12)
          && (!has('status') || body().status in ['pending', 'paid']) && num('ts');
    }
    match /verseUnlocks/{id} {
      allow get, list: if true;
      allow create: if okVerseUnlock();
      allow update: if okVerseUnlock();
      allow delete: if true;
    }

    // =====================================================================
    // V06 VERSE: PERAN ARTIS/GRUP (email -> akun)
    // =====================================================================
    function okStaff() {
      return small() && has('kind') && body().kind in ['artist', 'group'] && str('refId', 80) && str('groupId', 80) && has('ver') && str('ver', 40) && num('ts');
    }
    match /verseStaff/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if okStaff();
      allow update: if okStaff();
      allow delete: if true;
    }

    // =====================================================================
    // V07 VERSE: PROFIL PENGGUNA
    // =====================================================================
    function okProfile() {
      return small() && str('nickname', 40) && str('uid', 128) && str('bio', 300) && str('photo', 120000) && str('av', 14000)
          && str('cover', 250000) && arr('unfollow', 300) && arr('follow', 300) && num('joined') && num('ts')
          && str('username', 20) && str('ph', 100) && str('ps', 60);
    }
    match /verseProfiles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid && okProfile();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // =====================================================================
    // V08 VERSE: POSTINGAN PENGGEMAR
    // =====================================================================
    // postingan penggemar (foto + Spotify) di komunitas
    function okFanPost() {
      return small() && request.auth != null && body().uid == request.auth.uid
          && str('name', 60) && str('av', 14000) && str('groupId', 80) && str('text', 2000) && arr('photos', 4)
          && (!has('spotify') || body().spotify == null || body().spotify is map) && num('likes') && num('ts');
    }
    match /verseFanPosts/{id} {
      allow get, list: if true;
      allow create: if okFanPost();
      allow update: if (request.auth != null && resource.data.uid == request.auth.uid && okFanPost())
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // =====================================================================
    // V09 VERSE: USERNAME UNIK
    // =====================================================================
    match /verseUsernames/{name} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && name.matches('[a-z0-9_.]{3,20}') && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'ts']);
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // =====================================================================
    // V10 VERSE: LANGGANAN CHAT & CALL (ditulis server saat bayar terdeteksi)
    // =====================================================================
    function nowMs() { return request.time.toMillis(); }
    function subActive(chatId) {
      return exists(/databases/$(database)/documents/verseSubs/$(chatId))
          && get(/databases/$(database)/documents/verseSubs/$(chatId)).data.end > nowMs();
    }
    // Dokumen langganan HANYA ditulis oleh server (api/pay-webhook.js, memakai service account yang melewati aturan ini)
    // setelah pembayaran QRIS terverifikasi. Aplikasi/klien tidak boleh membuat atau mengubahnya.
    match /verseSubs/{id} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // =====================================================================
    // V11 VERSE: PESAN CHAT
    // =====================================================================
    function okMsg() {
      return small() && request.auth != null
          && body().fanUid is string && body().artistId is string && body().chatId == body().fanUid + '_' + body().artistId
          && body().text is string && body().text.size() >= 1 && body().text.size() <= 1000
          && body().role in ['fan', 'artist'] && str('name', 60) && str('groupId', 80) && num('ts')
          && ((body().role == 'fan' && body().fanUid == request.auth.uid && body().uid == request.auth.uid && subActive(body().chatId))
              || (body().role == 'artist' && body().uid == request.auth.uid && isStaffFor(body().artistId)));
    }
    match /verseMsgs/{id} {
      allow get, list: if request.auth != null && (resource.data.fanUid == request.auth.uid || isStaffFor(resource.data.artistId));
      allow create: if okMsg();
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // =====================================================================
    // V12 VERSE: PANGGILAN SUARA (sinyal WebRTC)
    // =====================================================================
    function callParty(d) {
      return request.auth != null && (d.fanUid == request.auth.uid || isStaffFor(d.artistId));
    }
    function okCallDoc(id) {
      return small() && body().fanUid is string && body().artistId is string && id == body().fanUid + '_' + body().artistId && body().chatId == id
          && body().state in ['ringing', 'active', 'declined', 'ended']
          && str('name', 60) && str('groupId', 80) && str('offer', 30000) && str('answer', 30000) && num('ts');
    }
    match /verseCalls/{id} {
      allow get, list: if callParty(resource.data);
      allow create: if request.auth != null && okCallDoc(id) && request.resource.data.fanUid == request.auth.uid && body().state == 'ringing' && subActive(id);
      allow update: if callParty(resource.data) && okCallDoc(id) && body().fanUid == resource.data.fanUid && body().artistId == resource.data.artistId
          && (body().state != 'ringing' || (request.auth.uid == resource.data.fanUid && subActive(id)));
      allow delete: if callParty(resource.data);
    }

    // =====================================================================
    // V13 VERSE: SURAT UNTUK IDOL
    // =====================================================================
    function okLetter() {
      return small() && request.auth != null && body().fromUid == request.auth.uid
          && body().text is string && body().text.size() >= 5 && body().text.size() <= 1000
          && body().toArtistId is string && body().toArtistId.size() <= 80
          && str('fromName', 60) && str('toName', 100) && str('groupId', 80) && num('ts');
    }
    match /verseLetters/{id} {
      allow get, list: if request.auth != null
          && (resource.data.fromUid == request.auth.uid || isStaffFor(resource.data.toArtistId));
      allow create: if okLetter();
      allow update: if false;
      allow delete: if request.auth != null && resource.data.fromUid == request.auth.uid;
    }

    // =====================================================================
    // V14 VERSE: EVENT VOTE
    // =====================================================================
    function okVerseEvent() {
      return base() && str('title', 150) && str('desc', 500) && num('end') && num('ts') && arr('candidates', 30)
          && (!has('status') || body().status in ['open', 'closed']);
    }
    match /verseEvents/{id} {
      allow get, list: if true;
      allow create: if okVerseEvent();
      allow update: if okVerseEvent();
      allow delete: if true;
    }

    // =====================================================================
    // V15 VERSE: SUARA VOTE
    // =====================================================================
    function okVote(id) {
      return request.auth != null && body().uid == request.auth.uid && has('eventId') && body().eventId is string
          && id == body().eventId + '_' + request.auth.uid
          && body().keys().hasOnly(['eventId', 'uid', 'artistId', 'ts'])
          && exists(/databases/$(database)/documents/verseEvents/$(body().eventId))
          && get(/databases/$(database)/documents/verseEvents/$(body().eventId)).data.get('status', '') == 'open'
          && body().artistId in get(/databases/$(database)/documents/verseEvents/$(body().eventId)).data.get('candidates', []);
    }
    match /verseVotes/{id} {
      allow get, list: if true;
      allow create: if okVote(id);
      allow update: if false;
      allow delete: if !exists(/databases/$(database)/documents/verseEvents/$(resource.data.eventId));
    }

    // =====================================================================
    // V16 VERSE: BANNER IKLAN BERANDA (foto landscape, diatur dari Dasbor Admin)
    // =====================================================================
    function okVerseBanner() {
      return base() && str('id', 80) && pic('img') && str('title', 80) && str('link', 300) && flag('on') && num('order') && num('ts');
    }
    match /verseBanners/{id} {
      allow get, list: if true;
      allow create: if okVerseBanner();
      allow update: if okVerseBanner();
      allow delete: if true;
    }

    // =====================================================================
    // V17 VERSE: TAGIHAN PEMBAYARAN (dibuat & dilunasi oleh server; pemilik hanya boleh membaca tagihannya sendiri)
    // =====================================================================
    match /verseOrders/{id} {
      allow get: if request.auth != null && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    // =====================================================================
    // S01 PENGATURAN UMUM
    // =====================================================================
    match /settings/{id} {
      allow get, list: if true;
      allow create: if small();
      allow update: if small();
      allow delete: if false;
    }

    // =====================================================================
    // PENUTUP: SEMUA KOLEKSI LAIN DITOLAK
    // =====================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
